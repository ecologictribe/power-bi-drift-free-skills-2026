{"$schemaNote": "spec schema v1 for build_from_spec.py. DiD cutoff 2024-07-01; Treatment = North/South Hub.",
  "project": "ForecastAnalytics",
  "dataDir": "D:/power_new/data_fcst",
  "tables": [
    {"name": "Consumption", "file": "Consumption.csv",
      "columns": [
        {"name": "RowID", "type": "int64", "source": "RowID"},
        {"name": "ProductID", "type": "int64", "source": "ProductID"},
        {"name": "WarehouseID", "type": "int64", "source": "WarehouseID"},
        {"name": "ConsDate", "type": "dateTime", "source": "ConsDate"},
        {"name": "Scenario", "type": "string", "source": "Scenario"},
        {"name": "ConsumptionQty", "type": "decimal", "source": "ConsumptionQty"},
        {"name": "StockoutDays", "type": "int64", "source": "StockoutDays"}],
      "measures": [
        {"name": "Total Consumption", "expr": "SUM(Consumption[ConsumptionQty])", "format": "#,##0.0", "desc": "Unfiltered consumption (splits by Scenario)."},
        {"name": "Actual Consumption", "expr": "CALCULATE(SUM(Consumption[ConsumptionQty]), Consumption[Scenario] = \"Actual\")", "format": "#,##0.0", "desc": "Actual consumption."},
        {"name": "Forecast Consumption", "expr": "CALCULATE(SUM(Consumption[ConsumptionQty]), Consumption[Scenario] = \"Forecast\")", "format": "#,##0.0", "desc": "Forecast consumption."},
        {"name": "Stockout Days", "expr": "SUM(Consumption[StockoutDays])", "format": "#,##0", "desc": "Total stockout days."},
        {"name": "Treat Pre", "expr": "CALCULATE(AVERAGE(Consumption[ConsumptionQty]), Warehouses[Group] = \"Treatment\", Consumption[ConsDate] < DATE(2024, 7, 1))", "format": "#,##0.0", "desc": "Treatment avg before policy."},
        {"name": "Treat Post", "expr": "CALCULATE(AVERAGE(Consumption[ConsumptionQty]), Warehouses[Group] = \"Treatment\", Consumption[ConsDate] >= DATE(2024, 7, 1))", "format": "#,##0.0", "desc": "Treatment avg after policy."},
        {"name": "Ctrl Pre", "expr": "CALCULATE(AVERAGE(Consumption[ConsumptionQty]), Warehouses[Group] = \"Control\", Consumption[ConsDate] < DATE(2024, 7, 1))", "format": "#,##0.0", "desc": "Control avg before policy."},
        {"name": "Ctrl Post", "expr": "CALCULATE(AVERAGE(Consumption[ConsumptionQty]), Warehouses[Group] = \"Control\", Consumption[ConsDate] >= DATE(2024, 7, 1))", "format": "#,##0.0", "desc": "Control avg after policy."},
        {"name": "DiD Estimate", "expr": "([Treat Post] - [Treat Pre]) - ([Ctrl Post] - [Ctrl Pre])", "format": "#,##0.0", "desc": "Differences-in-differences policy effect."}],
      "partition": {"columns": ["RowID", "ProductID", "WarehouseID", "ConsDate", "Scenario", "ConsumptionQty", "StockoutDays"],
        "mtypes": ["Int64.Type", "Int64.Type", "Int64.Type", "type datetime", "type text", "type number", "Int64.Type"]}},
    {"name": "Warehouses", "file": "Warehouses.csv",
      "columns": [
        {"name": "WarehouseID", "type": "int64", "source": "WarehouseID", "key": true},
        {"name": "WarehouseName", "type": "string", "source": "WarehouseName"},
        {"name": "Group", "type": "string", "source": "Group"}],
      "measures": [
        {"name": "Warehouse Count", "expr": "DISTINCTCOUNT(Warehouses[WarehouseID])", "format": "#,##0", "desc": "Number of warehouses."}],
      "partition": {"columns": ["WarehouseID", "WarehouseName", "Group"],
        "mtypes": ["Int64.Type", "type text", "type text"]}},
    {"name": "Products", "file": "Products.csv",
      "columns": [
        {"name": "ProductID", "type": "int64", "source": "ProductID", "key": true},
        {"name": "ProductName", "type": "string", "source": "ProductName"},
        {"name": "Category", "type": "string", "source": "Category"}],
      "measures": [
        {"name": "Product Count", "expr": "DISTINCTCOUNT(Products[ProductID])", "format": "#,##0", "desc": "Number of products."}],
      "partition": {"columns": ["ProductID", "ProductName", "Category"],
        "mtypes": ["Int64.Type", "type text", "type text"]}},
    {"name": "Dates", "file": "Dates.csv",
      "columns": [
        {"name": "Date", "type": "dateTime", "source": "Date", "key": true},
        {"name": "Year", "type": "int64", "source": "Year"},
        {"name": "Quarter", "type": "int64", "source": "Quarter"},
        {"name": "Month", "type": "int64", "source": "Month"},
        {"name": "MonthName", "type": "string", "source": "MonthName"},
        {"name": "DayOfWeek", "type": "string", "source": "DayOfWeek"},
        {"name": "DayOfMonth", "type": "int64", "source": "DayOfMonth"},
        {"name": "WeekOfYear", "type": "int64", "source": "WeekOfYear"},
        {"name": "IsWeekend", "type": "boolean", "source": "IsWeekend"}],
      "measures": [],
      "partition": {"columns": ["Date", "Year", "Quarter", "Month", "MonthName", "DayOfWeek", "DayOfMonth", "WeekOfYear", "IsWeekend"],
        "mtypes": ["type datetime", "Int64.Type", "Int64.Type", "Int64.Type", "type text", "type text", "Int64.Type", "Int64.Type", "type logical"]},
      "hierarchies": [{"name": "Calendar", "levels": [
        {"level": "Year", "column": "Year"},
        {"level": "Quarter", "column": "Quarter"},
        {"level": "Month", "column": "Month"}]}]}],
